// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "registry.bht-berlin.de:443/templates/container/we:SS26a",
	
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [ 2990, 3000, 3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009, 3010, 3011 ],
	
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "",
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"-dbaeumer.vscode-eslint",
				"-github.copilot",
				"-github.copilot-chat",
				"donjayamanne.githistory",
				"firefox-devtools.vscode-firefox-debug",
				"humao.rest-client",
				"mikestead.dotenv",
				"ms-vscode-remote.remote-containers",
				"ms-vscode.extension-test-runner",
				"ms-vscode.live-server",
				"orta.vscode-jest",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-german",
				"usernamehw.errorlens",
				"vitest.explorer"
			],
			"settings": {
				// Copilot Settings, cf. https://code.visualstudio.com/docs/copilot/reference/copilot-settings
				// General Copilot Settings 
				"chat.commandCenter.enabled": false,
				"workbench.settings.showAISearchToggle": false,
				"search.searchView.keywordSuggestions": false,
				"chat.disableAIFeatures": true,
				// Code editing settings
				"github.copilot.editor.enableCodeActions": false,
				"github.copilot.renameSuggestions.triggerAutomatically": false,
				"github.copilot.enable": {
					"*": false,
					"plaintext": false,
					"markdown": false,
					"typescript": false,
					"javascript": false
				},
				"github.copilot.nextEditSuggestions.enabled": false,
				"editor.inlineSuggest.edits.allowCodeShifting": "never",
				"editor.inlineSuggest.edits.renderSideBySide": "never",
				"github.copilot.nextEditSuggestions.fixes": false,
				"editor.inlineSuggest.edits.showCollapsed": false,
				"editor.inlineSuggest.showToolbar": "never",
				// Chat settings
				"github.copilot.chat.localeOverride": "ja",
				"github.copilot.chat.useProjectTemplates": false,
				"github.copilot.chat.scopeSelection": false,
				"chat.detectParticipant.enabled": false,
				"chat.checkpoints.enabled": false,
				"chat.editRequests": "none",
				"workbench.browser.enableChatTools": false,
				// Agent settings
				"chat.agent.enabled": false,
				"github.copilot.chat.agent.autoFix": false,
				"chat.autopilot.enabled": false,
				"github.copilot.chat.claudeAgent.enabled": false,
				// Agent sessions
				"chat.viewSessions.enabled": false,
				"chat.agentsControl.enabled": false,
				"chat.unifiedAgentsBar.enabled": false,
				// Code review settings
				"github.copilot.chat.reviewSelection.enabled": false,
				// 'Agent skills settings'
				"chat.useAgentSkills": false,
				// Agent Plugin Settings
				"chat.plugins.enabled": false,
				// other settings not listed on https://code.visualstudio.com/docs/copilot/reference/copilot-settings
				"github.copilot.chat.copilotDebugCommand.enabled": false,
				"github.copilot.chat.reviewAgent.enabled": false,
				"chat.extensionTools.enabled": false,
				"cSpell.caseSensitive": false,
				"cSpell.diagnosticLevel": "Hint",
				"cSpell.language": "de-de,en",
				"cSpell.languageSettings": [
					{
						"caseSensitive": false,
						"languageId": "*",
						"locale": "de,en"
					}
				],
				"cSpell.ignoreRegExpList": [
					"/\\\\[a-zA-Z]+\\b/g",
					"/\\\\@[a-zA-Z]+\\b/g"
				],
				"dev.containers.defaultExtensions": [],
				"workbench.tree.indent": 16,
				"files.exclude": {
					"**/.git": true,
					"**/.DS_Store": true,
					"**/.DS Store": true
				}
			}
		}
	}
	,"postStartCommand": "rm -rf /home/dev/.vscode-server/extensions/github.copilot* && clear && clear"
}
