// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	// Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "jevopi/we:SS26d",

	// Disable ipv6 in the container, otherwise "localhost" is not visible
	// https://docs.docker.com/reference/cli/docker/container/run/#sysctl
	// needs to be set in Docker 26.0.0, cf. 
	// https://github.com/moby/moby/releases/tag/v26.0.0
	"runArgs": ["--sysctl", "net.ipv6.conf.all.disable_ipv6=1"],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [ 2990, 3000, 3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009, 3010, 3011 ],
	
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "",
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"live preview",
				"donjayamanne.githistory",
				"firefox-devtools.vscode-firefox-debug",
				"humao.rest-client",
				"mikestead.dotenv",
				"ms-vscode.extension-test-runner",
				"ms-vscode.live-server",
				"orta.vscode-jest",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-german",
				"usernamehw.errorlens",
				"vitest.explorer"
			]
		}
	}
	,"postStartCommand": "rm -rf /home/dev/.vscode-server/extensions/github.copilot* && clear && clear"
}
